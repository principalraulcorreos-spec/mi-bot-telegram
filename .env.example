# Copia este archivo a ".env" (para pruebas locales) o configura estas mismas
# variables como "Environment Variables" en tu proveedor de hosting (Render,
# Railway, etc). NUNCA subas tu ".env" real a GitHub — ya está en .gitignore.

# --- Obligatorias ---

# Token de tu bot de Telegram. Se obtiene hablando con @BotFather en Telegram
# (comando /newbot) y copiando el token que te da.
BOT_TOKEN=

# --- Persistencia de datos (recomendado: Supabase) ---
# Si defines estas dos, el bot guarda todo en una tabla de Supabase (gratis)
# y los datos sobreviven a reinicios/redeploys. Si las dejas vacías, el bot
# usa un archivo registro.json local (se PIERDE en hostings con disco
# efímero como Render free tier).
#
# 1. Crea un proyecto gratis en https://supabase.com
# 2. Ve a "SQL Editor" y corre:
#      create table bot_data (id int primary key, data jsonb);
#      insert into bot_data (id, data) values (1, '{}');
# 3. Ve a Settings -> API y copia la URL y la "service_role secret key"
SUPABASE_URL=
SUPABASE_KEY=

# --- IA (Groq) ---
# Necesaria para el coach de IA, transcripción de voz, análisis de fotos de
# recibos/trades y los reportes narrados. Cuenta gratis en https://console.groq.com
GROQ_API_KEY=

# --- Google Calendar / Gmail (opcional) ---
# Solo necesarias si quieres que el bot lea tu agenda de Google Calendar o
# detecte automáticamente transacciones desde tus correos de Gmail.
# Se obtienen creando un proyecto en https://console.cloud.google.com,
# habilitando las APIs de Calendar/Gmail, creando credenciales OAuth tipo
# "Aplicación de escritorio", descargando el credentials.json y corriendo
# "python gmail_auth.py" (ver MANUAL.md paso 6) para generar el refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN_1=
GMAIL_REFRESH_TOKEN_2=

# --- Opcional ---
# chat_id de Telegram para forzar el destinatario de los mensajes/jobs
# automáticos antes de que el bot lo aprenda solo (al recibir tu primer /start
# ya no hace falta, se guarda automáticamente).
CHAT_ID=

# Carpeta donde se guarda registro.json si NO usas Supabase. Por defecto usa
# la misma carpeta del proyecto. En Render sin disco persistente, esto se
# borra en cada redeploy — por eso se recomienda usar Supabase.
DATA_DIR=
